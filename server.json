{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Gandr-AI/gandr-mcp",
  "description": "Gandr TTS: 146 ms client / 116 ms server warm first audio.",
  "repository": {
    "url": "https://github.com/Gandr-AI/gandr-mcp",
    "source": "github"
  },
  "version": "0.1.7",
  "websiteUrl": "https://gandr.ai",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "gandr-mcp",
      "version": "0.1.7",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Gandr API key, starts with gnd_. Free key at https://gandr.ai",
          "isRequired": true,
          "isSecret": true,
          "name": "GANDR_API_KEY"
        }
      ]
    }
  ]
}
